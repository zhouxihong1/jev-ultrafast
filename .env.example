# Jev Ultrafast configuration. Copy to .env — .env is git-ignored.
# Every value below is optional except the keys for the backends you enable.
# Resolution order: environment variable > provider preset > built-in default.
# Check the result with:  jev-doctor          jev-doctor --live

# ---------------------------------------------------------------- Jev decision endpoint
# classifier : keyless classification facade. One POST for the operation, and one more for
#              the target when that operation has more than one candidate. Simplest to start.
# typesafe   : the native /v1/systemone protocol, which answers both heads in one request.
JEV_BACKEND=classifier

# classifier.dev serves the same model (jev-1.13.0, provider typesafe) behind {input, labels}.
# Anonymous use is allowed ONLY over a direct connection; through a proxy the API answers
# "Anonymous proxy traffic requires a funded API key". So this endpoint ignores proxy
# environment variables unless you opt in below.
CLASSIFIER_URL=https://classifier.dev/
# CLASSIFIER_API_KEY=
# CLASSIFIER_TIER=fast
# CLASSIFIER_TIMEOUT=25
# CLASSIFIER_MAX_INPUT=24000
# CLASSIFIER_USE_ENV_PROXY=0

# --- the native TypeSafe protocol, if you have a key for it ---
TYPESAFE_MODEL=jev-latest
# TYPESAFE_API_KEY=
# TYPESAFE_BASE_URL=https://api.typesafe.ai
# TYPESAFE_PATH=/v1/systemone
# Full-URL override; wins over BASE_URL + PATH, e.g. http://127.0.0.1:8080/mock/systemone
# TYPESAFE_URL=
# TYPESAFE_TIMEOUT=25
# TYPESAFE_EXTRA_HEADERS={"X-Org":"team-a","X-Trace-Source":"jev"}
# Set when TYPESAFE_BASE_URL is a keyless local gateway.
# TYPESAFE_ALLOW_NO_KEY=0

# --------------------------------------------------------------- TEXT_TEXT helper endpoint
# Required for TYPE_TEXT. Any OpenAI-compatible /chat/completions server works.
TEXT_MODEL_API_KEY=
TEXT_MODEL_BASE_URL=https://openrouter.ai/api/v1
TEXT_MODEL=inception/mercury-2.5
# none | off | low | medium | high | minimal | a raw JSON object. Unset = provider default.
TEXT_MODEL_REASONING=none
# Shorthand presets that fill BASE_URL/MODEL/reasoning when those are unset:
#   openrouter openai deepseek siliconflow dashscope moonshot zhipu ollama vllm lmstudio
# TEXT_MODEL_PROVIDER=deepseek
# TEXT_MODEL_PATH=/chat/completions
# Full-URL override, wins over BASE_URL + PATH (e.g. Azure: https://x.openai.azure.com/openai/deployments/y/chat/completions?api-version=2024-06-01)
# TEXT_MODEL_URL=
# bearer | api-key | x-api-key | none
# TEXT_MODEL_AUTH_STYLE=bearer
# TEXT_MODEL_EXTRA_HEADERS={"HTTP-Referer":"https://example.com","X-Title":"jev"}
# auto | on | off — response_format={"type":"json_object"}. Set off for servers that reject it.
# TEXT_MODEL_JSON_MODE=auto
# TEXT_MODEL_MAX_TOKENS=1024
# TEXT_MODEL_TEMPERATURE=0
# TEXT_MODEL_TIMEOUT=30
# Set when using a keyless local server that is not on the preset list.
# TEXT_MODEL_ALLOW_NO_KEY=0

# ------------------------------------------------------------------------------- runtime
# Action budget for one run.
# JEV_MAX_STEPS=60
# Default search engine when a sentence names none: baidu google bing sogou so duckduckgo
# zhihu weibo bilibili taobao jd github youtube wikipedia
# JEV_DEFAULT_SEARCH_ENGINE=baidu
# Explicit .env location. Otherwise: cwd/.env -> repo/.env -> ~/.jev/.env
# JEV_ENV_FILE=
# Browser executable, port, and dedicated profile used by `jev-browser start`.
# JEV_CHROME=
# JEV_CHROME_PORT=9333
# JEV_CHROME_PROFILE=

# ------------------------------------------------------------------------------- jev-serve
# JEV_SERVE_HOST=127.0.0.1
# JEV_SERVE_PORT=8787
# JEV_SERVE_TOKEN=change-me
